options:
  parameters:
    author: Gary Schafer
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: psk8_modulator_differential
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: 8PSK Modulator / Demodulator with Differential Encoding
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: A
  id: variable
  parameters:
    comment: 'Value: np.cos(np.pi/8)'
    value: np.cos(np.pi/8)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [424, 36.0]
    rotation: 0
    state: true
- name: B
  id: variable
  parameters:
    comment: 'Value: np.sin(np.pi/8)'
    value: np.sin(np.pi/8)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [584, 36.0]
    rotation: 0
    state: true
- name: psk_default
  id: variable_constellation
  parameters:
    comment: "Constellation Type: Variable Constellation\nSymbol Map: Doesn't matter\
      \ since its not\n                           used on the receive side.\nConstellation\
      \ Points: [-A+B*1j,-A-B*1j,-B-A*1j,B-A*1j,A-B*1j,A+B*1j,B+A*1j,-B+A*1j]"
    const_points: '[-A+B*1j,-A-B*1j,-B-A*1j,B-A*1j,A-B*1j,A+B*1j,B+A*1j,-B+A*1j]'
    dims: '1'
    normalization: digital.constellation.AMPLITUDE_NORMALIZATION
    precision: '8'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0,1,2,3,4,5,6,7]'
    type: calcdist
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1168, 12.0]
    rotation: 0
    state: true
- name: psk_map
  id: variable
  parameters:
    comment: 'Value: [A+B*1j,B+A*1j,-B+A*1j,-A+B*1j,-A-B*1j,-B-A*1j,B-A*1j,A-B*1j]'
    value: '[A+B*1j,B+A*1j,-B+A*1j,-A+B*1j,-A-B*1j,-B-A*1j,B-A*1j,A-B*1j]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [728, 36.0]
    rotation: 0
    state: true
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '48000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [192, 36.0]
    rotation: 0
    state: enabled
- name: analog_random_source_x_0
  id: analog_random_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    max: '8'
    maxoutbuf: '0'
    min: '0'
    minoutbuf: '0'
    num_samps: '1000'
    repeat: 'True'
    type: byte
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 140.0]
    rotation: 0
    state: true
- name: blocks_char_to_float_0
  id: blocks_char_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    scale: '1'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1336, 532.0]
    rotation: 0
    state: true
- name: blocks_char_to_float_0_0
  id: blocks_char_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    scale: '1'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [216, 596.0]
    rotation: 0
    state: true
- name: blocks_multiply_const_vxx_0
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: 'Rotation of the transmitted

      constellation by +90 degrees

      (pi/2 radians) in order to

      demonstrate differential

      encoding.

      -----------

      Constant: 1j'
    const: 1j
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [864, 316.0]
    rotation: 0
    state: true
- name: blocks_throttle_0
  id: blocks_throttle
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 164.0]
    rotation: 0
    state: true
- name: digital_chunks_to_symbols_xx_0
  id: digital_chunks_to_symbols_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'Transmitter

      -----------------

      Input Type: byte

      Output Type: complex

      Symbol Table: psk_map'
    dimension: '1'
    in_type: byte
    maxoutbuf: '0'
    minoutbuf: '0'
    num_ports: '1'
    out_type: complex
    symbol_table: psk_map
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [592, 400.0]
    rotation: 0
    state: true
- name: digital_constellation_decoder_cb_0
  id: digital_constellation_decoder_cb
  parameters:
    affinity: ''
    alias: ''
    comment: 'Receiver

      -------------

      Constellation Object: psk_default'
    constellation: psk_default
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1096, 260.0]
    rotation: 0
    state: true
